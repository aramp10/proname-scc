#!/bin/bash -l
#$ -j y
# Submitted by submit.sh -- not meant to be run by hand.
# submit.sh sets the project, cores, run time, and PIPELINE_DIR/STEP/PREV_STEP.

echo "Step: $STEP | host: $(hostname) | cores: $NSLOTS | start: $(date)"
source "$PIPELINE_DIR/config.sh"
cd "$WORKDIR" || exit 1

# Don't start if the previous step did not finish successfully
if [ -n "$PREV_STEP" ] && [ ! -f ".done_$PREV_STEP" ]; then
  echo "ERROR: step '$PREV_STEP' did not finish successfully -- not running '$STEP'."
  echo "Check that step's log (proname_$PREV_STEP.o<jobID>) in $WORKDIR."
  exit 1
fi

EXTRA=()
[ "$STEP" = taxonomy ] && EXTRA=("$WORKDIR/sample_metadata.tsv")

scc-singularity exec "$SIF" bash "$PIPELINE_DIR/steps/$STEP.sh" "$PIPELINE_DIR/config.sh" "${EXTRA[@]}"

# Exit codes can't be trusted here (PRONAME and scc-singularity both return 0
# on failure), so check that the step produced its main output instead.
case "$STEP" in
  import)   ok() { [ -s reads_simplex_duplex.fastq ]; } ;;
  filter)   ok() { [ -n "$(ls -A HQ 2>/dev/null)" ]; } ;;
  refine)   ok() { [ -s rep_seqs.qza ] && [ -s rep_table.qza ]; } ;;
  taxonomy) ok() { [ -s taxonomy_blastn.qza ]; } ;;
esac
if ok; then
  touch ".done_$STEP"
  echo "Step $STEP finished OK: $(date)"
else
  echo "ERROR: step $STEP did not produce its expected output -- see the messages above: $(date)"
  exit 1
fi
